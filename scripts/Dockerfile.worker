FROM node:22-bookworm AS node
FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && npm install -g @openai/codex@0.153.0 \
 && apt-get update && apt-get install -y --no-install-recommends git python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 TZ=Asia/Tokyo
WORKDIR /opt/cache-seed
RUN npm install --cache /opt/npm-cache react react-dom react-router-dom typescript vite @vitejs/plugin-react @playwright/test
RUN dotnet new webapi --framework net8.0 --no-restore --output backend \
 && cd backend \
 && dotnet add package Microsoft.EntityFrameworkCore.Sqlite --version 8.0.19 \
 && dotnet add package Microsoft.EntityFrameworkCore.Design --version 8.0.19 \
 && dotnet add package BCrypt.Net-Next \
 && dotnet add package CsvHelper \
 && dotnet restore --packages /opt/nuget-cache
RUN rm -rf /opt/cache-seed && chmod -R a+rX /opt/npm-cache /opt/nuget-cache
ENV NUGET_PACKAGES=/opt/nuget-cache npm_config_cache=/tmp/npm-cache
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN npm exec --cache /opt/npm-cache --package @playwright/test@1.63.0 -- playwright install --with-deps chromium \
 && chmod -R a+rX /opt/playwright-browsers
WORKDIR /workspace
